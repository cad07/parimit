# Local demonstration settings only. Never put real PSP, bank, UPI, OTP or PIN
# credentials in this project.
PARIMIT_HOST=127.0.0.1
PARIMIT_PORT=8787
PARIMIT_DB_PATH=./data/parimit.db
PARIMIT_DEMO_MODE=true
PARIMIT_AUTH_MODE=demo_headers
# Leave empty only for the isolated local demo. OIDC mode fails closed until
# this is replaced with at least 32 random UTF-8 bytes.
PARIMIT_RECEIPT_KEY=
# Container-only override for a host-loopback published port. Never enable on
# a host or network interface reachable by other machines.
# PARIMIT_DEMO_ALLOW_NON_LOOPBACK_HEADERS=false

# Shared pilots must use OIDC, HTTPS, a non-demo mode, and a strong receipt key.
# PARIMIT_DEMO_MODE=false
# PARIMIT_AUTH_MODE=oidc
# PARIMIT_OIDC_ISSUER=https://identity.example.com/
# PARIMIT_OIDC_AUDIENCE=parimit-api
# PARIMIT_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# PARIMIT_OIDC_ROLE_CLAIM=roles
# PARIMIT_OIDC_ROLE_MAPPING={"parimit-agent":"agent","parimit-reviewer":"approver","parimit-admin":"admin"}
# PARIMIT_OIDC_CLOCK_SKEW_SECONDS=60
# PARIMIT_OIDC_MAX_TOKEN_LIFETIME_SECONDS=3600
# Optional: at+jwt or JWT only when the identity provider guarantees that type.
# PARIMIT_OIDC_REQUIRED_TYP=

# Policy values use INR minor units (paise).
PARIMIT_PER_TX_LIMIT=100000
PARIMIT_DAILY_AGENT_LIMIT=500000
PARIMIT_DUAL_APPROVAL_THRESHOLD=50000
PARIMIT_INTENT_TTL_SECONDS=1800
PARIMIT_MAX_EXPIRY_SECONDS=86400
PARIMIT_BLOCKED_PAYEES=blocked-merchant,test-fraud
# Leave blank to disable the allowlist. When set, use comma-separated aliases.
PARIMIT_ALLOWED_PAYEES=
