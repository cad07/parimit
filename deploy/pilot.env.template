# Copy to deploy/.env.pilot, restrict it to the operator account, and never
# commit it. Use only fictional payees and synthetic data in this pilot.

# Give every locally built release a unique immutable label, ideally including
# the release tag and commit abbreviation. Retain the prior image for rollback.
PARIMIT_IMAGE_TAG=0.1.0-alpha.2-local
PARIMIT_UPSTREAM_PORT=8787

# Generate a unique value with a trusted secret manager or: openssl rand -base64 48
PARIMIT_RECEIPT_KEY=

PARIMIT_OIDC_ISSUER=https://identity.example.com/tenant
PARIMIT_OIDC_AUDIENCE=parimit-pilot
PARIMIT_OIDC_JWKS_URI=https://identity.example.com/tenant/.well-known/jwks.json
PARIMIT_OIDC_ROLE_CLAIM=roles
PARIMIT_OIDC_ROLE_MAPPING={"parimit-pilot-agent":"agent","parimit-pilot-reviewer":"approver","parimit-pilot-admin":"admin"}
PARIMIT_OIDC_CLOCK_SKEW_SECONDS=60
PARIMIT_OIDC_MAX_TOKEN_LIFETIME_SECONDS=3600
# Set only if the provider guarantees this access-token header: at+jwt or JWT.
PARIMIT_OIDC_REQUIRED_TYP=

# INR minor units (paise). These examples are intentionally conservative.
PARIMIT_PER_TX_LIMIT=100000
PARIMIT_DAILY_AGENT_LIMIT=500000
PARIMIT_DUAL_APPROVAL_THRESHOLD=50000
PARIMIT_INTENT_TTL_SECONDS=1800
PARIMIT_MAX_EXPIRY_SECONDS=86400

# The external pilot requires an allowlist of fictional aliases.
PARIMIT_ALLOWED_PAYEES=merchant_pilot_001,merchant_pilot_002
PARIMIT_BLOCKED_PAYEES=merchant_pilot_blocked
