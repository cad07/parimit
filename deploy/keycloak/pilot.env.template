# Copy this file to deploy/keycloak/.env.local, keep mode 0600, and replace
# every blank value using the repository bootstrap helper. Never commit the
# generated file or paste its values into issues, logs, or chat.

PARIMIT_IMAGE_TAG=local-unreleased

# Fixed identity-verifier topology. These are non-secret but trust-bound: any
# change requires a fresh Parimit data volume and a new acceptance record.
PARIMIT_AUTH_MODE=oidc
PARIMIT_DEMO_MODE=false
PARIMIT_OIDC_ISSUER=https://localhost:8443/realms/parimit-pilot
PARIMIT_OIDC_AUDIENCE=parimit-pilot
PARIMIT_OIDC_JWKS_URI=https://keycloak:8443/realms/parimit-pilot/protocol/openid-connect/certs
PARIMIT_OIDC_ROLE_CLAIM=roles

# Keycloak's bootstrap administrator manages Keycloak itself. It is not the
# Parimit pilot-admin identity and must never receive a Parimit bearer token.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=pilot-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_HTTPS_KEYSTORE_PASSWORD=

# JSON-safe base64url secrets consumed once by the realm import. Changing
# them in this file does not update a realm that already exists in the volume.
PARIMIT_AGENT_CLIENT_SECRET=
PARIMIT_CONSUMER_CLIENT_SECRET=
PARIMIT_REVIEWER_INITIAL_PASSWORD=
PARIMIT_ADMIN_INITIAL_PASSWORD=

# Parimit's database integrity key and stable Ed25519 signing key. These are a
# recovery set with the Parimit data volume; never rotate either casually.
PARIMIT_RECEIPT_KEY=
PARIMIT_TENANT_ID=parimit-pilot-local
PARIMIT_ENVELOPE_ISSUER=urn:parimit:pilot:local
PARIMIT_ENVELOPE_AUDIENCES=urn:parimit:consumer:pilot-local
PARIMIT_ENVELOPE_TTL_SECONDS=300
PARIMIT_ENVELOPE_SIGNING_KEY_ID=
PARIMIT_ENVELOPE_PRIVATE_KEY_PEM_BASE64=

# Keycloak issues five-minute access tokens. Parimit accepts no token whose
# exp-iat exceeds this upper bound.
PARIMIT_OIDC_CLOCK_SKEW_SECONDS=30
PARIMIT_OIDC_MAX_TOKEN_LIFETIME_SECONDS=600

# INR minor units (paise), using fictional aliases only.
PARIMIT_PER_TX_LIMIT=100000
PARIMIT_DAILY_AGENT_LIMIT=500000
PARIMIT_DUAL_APPROVAL_THRESHOLD=50000
PARIMIT_INTENT_TTL_SECONDS=1800
PARIMIT_MAX_EXPIRY_SECONDS=86400
PARIMIT_ALLOWED_PAYEES=merchant_pilot_001,merchant_pilot_002,demo-coffee-merchant
PARIMIT_BLOCKED_PAYEES=merchant_pilot_blocked
